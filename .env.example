# ══════════════════════════════════════════════════════════════
# InkOS 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ══════════════════════════════════════════════════════════════

# ── LLM提供商配置 ──
# 支持: openai, anthropic, custom
INKOS_LLM_PROVIDER=openai

# API基础URL（OpenAI兼容端点）
INKOS_LLM_BASE_URL=https://api.openai.com/v1

# API密钥（⚠️ 不要提交到Git）
INKOS_LLM_API_KEY=sk-your-key-here

# 模型名称
INKOS_LLM_MODEL=gpt-4o

# ── 数据库配置（生产环境） ──
# DATABASE_URL="postgresql://inkos:password@localhost:5432/inkos"

# ── 通知配置（可选） ──
INKOS_TELEGRAM_BOT_TOKEN=
INKOS_TELEGRAM_CHAT_ID=
INKOS_FEISHU_WEBHOOK_URL=
INKOS_WECOM_WEBHOOK_URL=

# ── 封面生成（可选） ──
# INKOS_COVER_API_KEY=your-cover-api-key

# ── Web搜索（可选） ──
# TAVILY_API_KEY=tvly-your-tavily-key
